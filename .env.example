# Optional: LLM Provider API Keys for running live real-model benchmarks
# Set one of the following:

# Google Gemini (Default for live-harness)
GEMINI_API_KEY=your_gemini_api_key_here
BENCH_MODEL=models/gemini-3.1-flash-lite

